# Copy this file to .env and fill in real values. Never commit .env.

# Required for grounded answer generation (generation/generator.py)
ANTHROPIC_API_KEY=

# Qdrant vector database connection (retrieval/dense.py)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hybrid_rag_chunks

# Sentence-transformers embedding model (retrieval/dense.py)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Directory containing source PDFs/Markdown to ingest (ingestion/loader.py)
CORPUS_DIR=corpus

# FastAPI server (api/main.py)
API_HOST=0.0.0.0
API_PORT=8000
